# Получите токен у @BotFather
BOT_TOKEN=1234567890:replace_me

# Telegram ID владельца. Только владелец управляет доступом менеджеров.
# Узнать свой ID можно у @userinfobot.
OWNER_ID=5961883311

# Реквизиты показываются покупателю перед отправкой чека.
PAYMENT_DETAILS=Банк: Example Bank\nКарта: 0000 0000 0000 0000\nПолучатель: И. И.

# Цена одной звезды в рублях. Например: 1.75
PRICE_PER_STAR_RUB=2.00

# Ограничения для произвольного количества.
MIN_STARS=50
MAX_STARS=100000

# Путь можно оставить без изменений.
DATABASE_PATH=data/orders.db
